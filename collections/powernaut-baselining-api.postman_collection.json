{
  "item": [
    {
      "id": "f8b35eef-2ff7-4d29-8bba-5fc85d5f7c6e",
      "name": "baselining",
      "description": {
        "content": "With baselining, you indicate your normal consumption/production behaviour.\n\nThis baseline is essential to provide flexibility, which is then defined as a deviation from this baseline. You can provide a baseline either for a site, or a resource.\n\nSee the [guide](/guides/connect/activating-flexibility/baselining) for more information.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "00036068-683d-418f-a478-33f48f7ca09d",
          "name": "Site baseline",
          "request": {
            "name": "Site baseline",
            "description": {
              "content": "Retrieve baseline data for the site (`active` power only).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "connect",
                "sites",
                ":id",
                "baseline"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "<number>",
                  "description": "(Required) Number of timesteps to be included in the time window."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "(Required) Start of window (ISO 8601). Must be a perfect minute without seconds or milliseconds precision.\n\n**Note**: To avoid timezone issues, we perform an additional check for the presence of timezone information. You should always include either UTC with `Z`, or an offset like `+01:00`."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "(Required) The granularity to fetch the state for, i.e. the time length of each element.\n\nIt cannot be smaller than 1 minute, and cannot contain sub-minute precision.\n\nThe expected format is <a href=\"https://en.wikipedia.org/wiki/ISO_8601#Durations\" target=\"_blank\">ISO8601</a>."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Identifier of the site you want to retrieve the baseline data for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
