                "description": "Identifier of the resource you want to add a bid for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Creates a bid for a resource's flexibility during a specific time window.\n\n**Implicit override behavior:**\nIf an open bid already exists for the same resource and time window, this endpoint will automatically update the existing bid instead of creating a new one."
