      "name": "creating_bids",
      "description": {
        "content": "A bid tells us how much flexibility is available in a certain time window.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4fd30d4a-afc6-48c2-82ca-4bee585bdd97",
          "name": "Bid a resource",
          "request": {
            "name": "Bid a resource",
            "description": {
              "content": "Creates a bid for a resource's flexibility during a specific time window.\n\n**Implicit override behavior:**\nIf an open bid already exists for the same resource and time window, this endpoint will automatically update the existing bid instead of creating a new one.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "connect",
                "resources",
                ":id",
                "bid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Identifier of the resource you want to add a bid for."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timing\": {\n    \"start\": \"<dateTime>\",\n    \"end\": \"<dateTime>\"\n  },\n  \"curve\": [\n    {\n      \"value\": \"<decimal>\",\n      \"price\": \"<decimal>\"\n    }\n  ],\n  \"power_type\": \"<string>\",\n  \"expires_at\": \"<dateTime>\",\n  \"webhooks\": {\n    \"accepted\": \"<uri>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
