{
  "opencollection": "1.0.0",
  "info": {
    "name": "Powernaut authentication events API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Report event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.powernaut.io/v1/connect/resources/:id/events",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the resource to report the event for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Reports a new event for the specified resource.\n- `PV_CURTAILMENT_SCHEDULED`: report periods of PV curtailment\n- `MFRR_ACTIVATION`: report mFRR pool curtailment dispatched to a gateway"
        }
      ]
    }
  ],
  "bundled": true
}