{
  "item": [
    {
      "id": "aa5ec350-5c6c-43a1-a51f-cc2fe2d44679",
      "name": "events",
      "description": {
        "content": "Events are EMS-initiated control actions that deviate from a resource's default behaviour (e.g. PV curtailment due to negative tariffs).\n\nReporting these events helps us maintain clean training data for more accurate forecasting.\n\nSee the [guide](/guides/connect/forecasting/reporting-events) for more information.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1a5c6ae7-6ada-4bcd-8bbb-7e123e5555cb",
          "name": "Report event",
          "request": {
            "name": "Report event",
            "description": {
              "content": "Reports a new event for the specified resource.\n- `PV_CURTAILMENT_SCHEDULED`: report periods of PV curtailment\n- `MFRR_ACTIVATION`: report mFRR pool curtailment dispatched to a gateway",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "connect",
                "resources",
                ":id",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Identifier of the resource to report the event for."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"<string>\",\n  \"payload\": {\n    \"start\": \"<dateTime>\",\n    \"end\": \"<dateTime>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "b36a6bf0-05b5-4e0e-a490-a4245ee4c8b3",
