  "item": [
    {
      "id": "6f71ca60-b464-4d23-b82c-69a1c7a43558",
      "name": "getting_forecasts",
      "description": {
        "content": "You can retrieve forecasts to help plan your flexibility offerings and understand expected power consumption or production patterns.\n\nSee the [guide](/guides/connect/forecasting/getting-forecasts) for more information.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1f98343b-6238-404b-9914-42ab279125f3",
          "name": "Retrieve forecasted signals for a specific site",
          "request": {
            "name": "Retrieve forecasted signals for a specific site",
            "description": {},
            "url": {
              "path": [
                "v1",
                "connect",
                "sites",
                ":id",
                "forecast"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "(Required) Start of window (ISO 8601). Must be a perfect quarter hour without seconds or milliseconds precision.\n\n**Note**: To avoid timezone issues, we perform an additional check for the presence of timezone information. You should always include either UTC with `Z`, or an offset like `+01:00`."
                },
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "<number>",
                  "description": "(Required) The number of forecast data points to retrieve."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "(Required) The granularity to fetch the forecast for, i.e. the time length of each element.\n\nOnly 15-minute granularity is supported.\n\nThe expected format is <a href=\"https://en.wikipedia.org/wiki/ISO_8601#Durations\" target=\"_blank\">ISO8601</a>."
                },
                {
                  "disabled": false,
                  "key": "signal",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Identifier of the site (UUID format)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
