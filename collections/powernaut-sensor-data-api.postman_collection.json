  "item": [
    {
      "id": "e9d33bd8-4c2e-437a-bd9d-3ce9ba7edb71",
      "name": "sensor_data",
      "description": {
        "content": "Read raw time series data from sensors attached to your sites, such as irradiance sensors on PV installations.\n\nUseful when you need measured conditions alongside metering data, for example to estimate PV output during curtailment windows.\n\nSee the [guide](/guides/connect/sensor-data/reading-sensor-data) for more information.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f70d0111-811c-446e-b641-c01d50769bc4",
          "name": "List sensors for a site",
          "request": {
            "name": "List sensors for a site",
            "description": {
              "content": "Returns all sensors linked to the site. Each entry includes the sensor's `external_id` (your gateway device key) and the `id` you need for `GET /v1/connect/sensors/{id}/readings`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "connect",
                "sites",
                ":id",
                "sensors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Identifier of the site (UUID)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
