        {
          "id": "fd79e659-3e2a-4858-8e87-816a2e9f085a",
          "name": "Get sensor readings (15-minute averages)",
          "request": {
            "name": "Get sensor readings (15-minute averages)",
            "description": {
              "content": "Returns 15-minute average readings for a single sensor over a `[start, end)` window. Sensors emitting at higher cadence (e.g. 1- or 5-minute) are normalised by averaging all raw samples within each quarter-hour bucket. Buckets with no readings are omitted. Timestamps are the start of the bucket and are returned in UTC.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "connect",
                "sensors",
                ":id",
                "readings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "(Required) Start of the window (ISO 8601 with timezone, e.g. `2026-01-15T00:00:00Z`). Inclusive."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "(Required) End of the window (ISO 8601 with timezone). Exclusive."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "1-based page number. Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "1000",
                  "description": "Readings per page. Defaults to 1000, maximum 10000."
                },
                {
                  "disabled": false,
                  "key": "measurement",
                  "value": "<string>",
                  "description": "Measurement channel to return, matching one of the sensor's `measurements[].key` values (e.g. `irradiance`, `cell_temperature`, `external_temperature`, `wind_speed`). Optional; defaults to `irradiance` when omitted."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Identifier of the sensor (UUID)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
